  "query": "\n    SELECT\n    song.id,\n    song.name as song_name,\n    artist.name as artist_name,\n    album.name as album_name\n    FROM\n    song\n    JOIN album ON song.album = album.id\n    JOIN artist ON song.album_artist = artist.id\n",
